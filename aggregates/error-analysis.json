{
  "schema_version": 1,
  "scope": "Paired field-level error counts on the common historical test set. A loss means production is correct and the candidate is wrong on a nonempty gold field; a win is the reverse. Shared errors and spurious predictions with empty gold are separate. Counts describe string relations, not annotation correctness or error causes.",
  "reference_model": "production",
  "reference_label": "Retained production Llama 3.1 8B outputs",
  "taxonomy": {
    "order": [
      "missed",
      "punct_only",
      "digits_only",
      "other_field",
      "shorter",
      "longer_with_other_field",
      "longer",
      "similar",
      "different"
    ],
    "definitions": {
      "missed": "Empty predicted field.",
      "punct_only": "A punctuation-only difference from the gold value.",
      "digits_only": "A digits-only difference from the gold value.",
      "other_field": "The prediction matches another field's gold value of at least three normalized characters.",
      "shorter": "The prediction is a proper substring of the gold value.",
      "longer_with_other_field": "The prediction is a superstring of gold that includes another field's gold value.",
      "longer": "The prediction is a proper superstring of the gold value.",
      "similar": "Other similar strings with a difflib ratio of at least 0.8.",
      "different": "No preceding string relation applies."
    },
    "rule": "Each loss is assigned to the first matching category. Relations use uppercase strings with non-alphanumeric characters removed; correctness and field presence follow the canonical evaluation contract."
  },
  "descriptor_presence_note": "Containment is checked after alphanumeric normalization. A lost gold value occurring in the input does not rule out an invented prediction.",
